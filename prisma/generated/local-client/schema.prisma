generator client {
  provider   = "prisma-client-js"
  output     = "./generated/local-client"
  engineType = "binary"
}

datasource db {
  provider = "sqlite"
  url      = "file:./local.db"
}

model InadimplenciaDiaria {
  id             Int      @id @default(autoincrement())
  dataReferencia DateTime @unique
  valorTotal     Float
  detalhes       String? // JSON string
  dataExecucao   DateTime @default(now())
}

model DashboardAggregates {
  id       Int      @id @default(autoincrement())
  idImovel Int
  tipo     String // "JURIDICOS", "AMIGAVEL", "RECEBIMENTO"
  data     DateTime
  total    Float

  @@index([tipo])
  @@index([idImovel])
  @@index([data])
}
